# Comma-separated API keys for the LLM. At least 2 keys required.
# Key ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-api-key-1,your-api-key-2

# SQLite database location (used inside Docker)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS origins allowed by the backend
ALLOWED_ORIGINS=http://localhost:3000

# Enable the X-Simulate-Failure header for failover testing
ENABLE_FAILURE_SIMULATION=true

# LLM model to use (LiteLLM format, e.g. groq/llama-3.3-70b-versatile or gemini/gemini-2.0-flash)
LLM_MODEL=groq/llama-3.3-70b-versatile

# Frontend: Backend API URL (used at build time)
VITE_API_URL=http://localhost:8000
